# ============================================================================
# ITACM — IT Asset Control Pro : environment configuration
# Copy to .env and fill in.   NEVER commit .env to git (already ignored).
#
# Fastest path: run `npm run setup` to generate this file with strong secrets,
# then `docker compose up -d`.
# ============================================================================

# HTTP port (local / Docker)
PORT=8000

# Extra allowed CORS origins for your frontend (blank = same-origin only)
CORS_ORIGINS=

# Public URL this instance is reached at — used ONLY for links in outbound email
# (alert digest, handover, owner-transfer). Prefer setting it in the app under
# Integrations → Notifications → App URL; this env var is the fallback if unset.
# Blank falls back to http://localhost:8000.
APP_URL=

# --- Database (docker compose fills the API URL from these three) -----------
POSTGRES_DB=itacm
POSTGRES_USER=itacm
# ⚠ CRITICAL: POSTGRES_PASSWORD is applied only when the database volume is
# FIRST created. Changing it here later and restarting will NOT work — the API
# will fail to log in. To change it safely (without losing data), run:
#     npm run change-db-password
# Never run "docker compose down -v" to "fix" it — that DELETES all your data.
POSTGRES_PASSWORD=change_me_strong_db_password

# Running the API outside compose? Point at your own Postgres instead:
DATABASE_URL=postgres://itacm:change_me_strong_db_password@localhost:5432/itacm
# For managed Postgres (Neon/Supabase/RDS) over TLS:
# PGSSL=true
# Only if the provider needs it (not recommended):
# PGSSL_INSECURE=true

# REQUIRED — JWT signing secret, min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Opt-in longer session when login sends rememberMe: true
JWT_REMEMBER_EXPIRES_IN=30d

# First-run Admin (created automatically when the users table is empty).
# If ADMIN_PASSWORD is empty, a random one is generated and printed ONCE in the
# server logs (docker compose logs api).
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=IT Admin
ADMIN_PASSWORD=

# Host port mapping for docker compose (host:8000)
API_PORT=8000

# Uploaded document files (handover scans, repair paperwork). Docker compose
# mounts a named volume at /app/data automatically.
# DATA_DIR=/app/data

# --- Automatic HTTPS (optional Caddy "tls" profile) --------------------------
# The domain this instance is served at. Point a DNS A/AAAA record at this host,
# set APP_DOMAIN below, then start with:  docker compose --profile tls up -d
# Caddy fetches + renews a Let's Encrypt certificate automatically (no certbot).
# Also set TRUST_PROXY=1 (below) and APP_URL=https://your-domain (above / in-app).
APP_DOMAIN=

# --- Security / reverse proxy ------------------------------------------------
# Enable ONLY when a reverse proxy (nginx, Traefik, Caddy) sits in front and
# strips / sets X-Forwarded-For correctly. Leaving this off prevents clients
# from spoofing req.ip (login rate-limit + setup token).
# Required when using the Caddy "tls" profile above.
# TRUST_PROXY=1
#
# DANGEROUS — broadcasts the one-time setup token to any client via API.
# Ignored in production unless you also set SETUP_TOKEN_PUBLIC_CONFIRM=I_UNDERSTAND.
# SETUP_TOKEN_PUBLIC=
# SETUP_TOKEN_PUBLIC_CONFIRM=
#
# Allow SMTP to private/RFC1918 hosts (internal Exchange etc.). Default denied.
# SMTP_ALLOW_PRIVATE=true

# Optional product-tour video on first-run onboarding (YouTube URL or direct MP4).
# If unset, the UI tries /media/how-it-works.mp4 then falls back to the animated demo.
# ONBOARDING_VIDEO_URL=https://www.youtube.com/watch?v=xxxxxxxx

# --- Upstream update check (opt-in) ------------------------------------------
# When on, the server asks GitHub — at most once a day — whether a release newer
# than the running version exists, and shows the Owner an "update available"
# popup. OFF by default: offline / air-gapped installs make no outbound request.
# This is only the DEFAULT — the Owner can flip it anytime under
# Integrations -> Software updates (the UI toggle overrides this value).
# UPDATE_CHECK=1
# UPDATE_CHECK_REPO=enesyaks/ITACM
# Optional token — only for a private repo or to lift the 60-req/hr anon limit.
# UPDATE_CHECK_TOKEN=ghp_xxx   # (GITHUB_TOKEN is also accepted)

# --- AI Assistant (optional) -------------------------------------------------
# Multi-provider ask-and-get assistant. Defaults to local Ollama when unset.
# Configure in UI: Integrations → AI Assistant (or set these env defaults).
# AI_ENABLED=1
# AI_PROVIDER=ollama          # ollama | deepseek | openai | anthropic | groq | mistral | together | openrouter | custom
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=llama3.1
# AI_API_KEY=                 # not needed for local Ollama
# Allow AI calls to localhost / private nets (Ollama). Default on for ollama provider.
# AI_ALLOW_PRIVATE=1
