# Dependencies
node_modules/

# Secrets & credentials
.env
data/
data/.itacm-bootstrap-password

# TLS material — never commit certificates or private keys (Cloudflare Origin cert)
certs/*.pem
certs/*.key
certs/*.crt

# Logs
*.log

# Database backups (may contain personal data — keep them out of git)
backups/

# Full-system migration packages (DB + documents) — repo root only.
# Unanchored, this pattern also swallowed src/providers/postgres/migrations/,
# so new schema migrations were invisible to git until added with -f.
/migrations/

# OS
.DS_Store

# Local tooling / session config
.claude/
.cursor/
docker-compose.override.yml

# Private security / pentest artefacts — never publish on a public remote
ITACM-Guvenlik-Raporu.html
*Guvenlik-Raporu*
docs/SECURITY-TESTING-PLAN.md
docs/TESTING.md
scripts/qa-report-*.json
