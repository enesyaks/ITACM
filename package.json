{
  "name": "itacm",
  "version": "1.8.3",
  "description": "IT Asset Control Pro — self-hosted IT asset management (PostgreSQL + Docker Compose) with a built-in web UI",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js tests/db/*.test.js",
    "setup": "node scripts/setup.js",
    "migrate": "node src/providers/postgres/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:infra": "node scripts/seed-infra-demo.js",
    "seed:providers": "node scripts/seed-providers-demo.js",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "migrate:export": "bash scripts/migrate-export.sh",
    "migrate:import": "bash scripts/migrate-import.sh",
    "change-db-password": "bash scripts/change-db-password.sh",
    "reset-password": "node scripts/reset-password.js",
    "lint": "node --check server.js && find src scripts -name '*.js' -exec node --check {} +",
    "seed:all": "node scripts/seed-all.js",
    "update": "bash scripts/update.sh",
    "test:db": "bash scripts/test-db.sh"
  },
  "keywords": [
    "it-asset-management",
    "inventory",
    "postgres",
    "express",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^1.7.6",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.16",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.7",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "author": "Enes Yakışık",
  "repository": {
    "type": "git",
    "url": "https://github.com/enesyakisik/itacm.git"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "tesseract.js": "^7.0.0"
  }
}
